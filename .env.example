NEXT_PUBLIC_SITE_URL=https://firstcallconsulting.ai
NEXT_PUBLIC_CONTACT_EMAIL=josh@firstcallconsulting.ai
LEAD_INBOX=josh@firstcallconsulting.ai
RESEND_API_KEY=
RESEND_FROM=First Call <hello@firstcallconsulting.ai>
STRIPE_SECRET_KEY=
# Foundation is a one-time setup fee + a recurring monthly retainer, billed
# together as one Stripe Checkout subscription session (the one-time price
# is charged once, on the first invoice). Create both prices in Stripe.
STRIPE_PRICE_FOUNDATION_SETUP=
STRIPE_PRICE_FOUNDATION_MONTHLY=
STRIPE_WEBHOOK_SECRET=
LEGAL_ENTITY_NAME=First Call
# CASL requires a valid mailing address in every commercial email. Set this
# before sending real marketing/lead emails.
NEXT_PUBLIC_MAILING_ADDRESS=[Street address, Calgary, AB, Canada]
# Secret used to sign one-click unsubscribe links (src/lib/unsubscribe.ts).
# Set a real random value in production; falls back to a dev-only default.
UNSUBSCRIBE_SECRET=

# Powers the Research + Implementation agents (src/lib/agents). Leave unset
# during development: the engine automatically falls back to a zero-cost
# rule-based mock (see AGENTS_MOCK_MODE) so nothing here ever costs money
# until you add a real key.
ANTHROPIC_API_KEY=
# Optional: override the default model used by both agents
ANTHROPIC_AGENT_MODEL=claude-sonnet-5
# true = always use the free rule-based engine, even if a key is set.
# false = require the real Claude agents (errors if no key is set).
# unset = mock automatically when ANTHROPIC_API_KEY is empty (the default).
AGENTS_MOCK_MODE=
# Shared secret required on POST /api/agents/run (the manual trigger endpoint)
ADMIN_API_SECRET=
